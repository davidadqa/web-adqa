<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ page.url | absUrl }}">
<link rel="alternate" hreflang="es" href="{{ page.url | absUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ page.url | absUrl }}">
<meta name="robots" content="{% if site.noindex %}noindex, nofollow{% elif noindex %}noindex, follow{% else %}index, follow, max-image-preview:large{% endif %}">
<meta name="theme-color" content="#E32772">
<meta property="og:locale" content="es_ES">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="ADQA">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ page.url | absUrl }}">
{%- set og = page.url | ogImage(title) %}
<meta property="og:image" content="{{ og.src | absUrl }}">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ og.alt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ og.src | absUrl }}">
<meta name="twitter:image:alt" content="{{ og.alt }}">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/figtree-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<script>document.documentElement.classList.add("adqa-js");setTimeout(function(){if(!window.__adqaRv)document.documentElement.classList.remove("adqa-js")},4000)</script>
<link rel="stylesheet" href="/assets/site.css">
{%- if site.env == "preview" %}
<link rel="stylesheet" href="/assets/revisio/revisio.css">
{%- endif %}
<script type="application/ld+json">
{% block jsonld %}{{ { url: page.url, title: title, description: description, isHome: isHome, pageType: pageType, service: service, breadcrumbs: breadcrumbs, faq: faq, extra: jsonldExtra } | jsonld | safe }}{% endblock %}
</script>
{% block head %}{% endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %} data-area="{{ page.url.split('/')[1] or 'home' }}"{% if category %} data-cat="{{ category }}"{% endif %}>
<a class="skip" href="#main">Saltar al contenido</a>

{% include "partials/sprite.njk" %}

{% include "partials/header.njk" %}

<main id="main">
{% block content %}{% endblock %}
</main>

{% include "partials/footer.njk" %}

<script src="/assets/site.js" defer></script>
{%- if site.env == "preview" %}
{#- Modo corrección: solo en la vista previa, nunca en producción. -#}
<script src="/assets/revisio/revisio.js" defer></script>
{%- endif %}
{% block scripts %}{% endblock %}
</body>
</html>
