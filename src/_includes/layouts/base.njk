<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ page.url | absUrl }}">
<link rel="alternate" hreflang="es" href="{{ page.url | absUrl }}">
<link rel="alternate" hreflang="x-default" href="{{ page.url | absUrl }}">
<meta name="robots" content="{% if site.noindex or noindex %}noindex, nofollow{% else %}index, follow, max-image-preview:large{% endif %}">
<meta name="theme-color" content="#E32772">
<meta property="og:locale" content="es_ES">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="ADQA">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ page.url | absUrl }}">
<meta property="og:image" content="{{ '/assets/og-adqa.jpg' | absUrl }}">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="ADQA · Informática, telecomunicaciones y ciberseguridad para empresas en Barcelona">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/assets/fonts/figtree-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css">
<script type="application/ld+json">
{{ { url: page.url, title: title, description: description, isHome: isHome, pageType: pageType, service: service, breadcrumbs: breadcrumbs, faq: faq, extra: jsonldExtra } | jsonld | safe }}
</script>
{% block head %}{% endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a class="skip" href="#main">Saltar al contenido</a>

{% include "partials/sprite.njk" %}

{% include "partials/header.njk" %}

<main id="main">
{% block content %}{% endblock %}
</main>

{% include "partials/footer.njk" %}

<script src="/assets/site.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
