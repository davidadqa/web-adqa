<footer>
  <div class="wrap">
    {#- Claim de marca, una sola vez y en su forma completa (decisión del cliente, revisión 1). -#}
    <div class="foot-claim">
      <p class="claim">Tocamos todas las <span class="accent">teclas</span><br class="br-wide"> para que solo tengas que tocar <kbd class="key">una</kbd>.</p>
      <a class="btn btn-primary" href="/contacto/">Hablemos <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <div class="foot">
      <div>
        <img class="logo" src="/assets/logo-adqa-blanco.svg" alt="ADQA" width="134" height="22">
        <p>{{ site.legalName }}<br>{{ site.address.street }}<br>{{ site.address.postalCode }} {{ site.address.locality }} · {{ site.address.region }}</p>
        <p style="margin-top:12px"><a href="tel:{{ site.phoneE164 }}">{{ site.phone }}</a> · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
      <nav aria-label="Servicios"><h4>Servicios</h4><ul>
        {%- for s in nav.services %}
        <li><a href="{{ s.url }}"{% if page.url == s.url %} aria-current="page"{% endif %}>{{ s.label }}</a></li>
        {%- endfor %}
      </ul></nav>
      <nav aria-label="Empresa"><h4>ADQA</h4><ul>
        <li><a href="/quienes-somos/">Quiénes somos</a></li>
        <li><a href="/casos-de-exito/">Casos de éxito</a></li>
        <li><a href="/recursos/">Recursos</a></li>
        <li><a href="/trabaja-con-nosotros/">Trabaja con nosotros</a></li>
        <li><a href="/contacto/">Contacto</a></li>
        <li><a href="/certificado-ens/">Certificado ENS</a></li>
        <li><a href="/certificado-bsi/">Certificado ISO 9001</a></li>
      </ul></nav>
      <nav aria-label="Clientes"><h4>Clientes</h4><ul>
        <li><a href="{{ site.extranet }}">Área de clientes</a></li>
        <li><a href="{{ site.extranet }}">Asistencia remota</a></li>
        <li><a href="{{ site.anxanet }}" rel="noopener">Anxanet, nuestro operador</a></li>
      </ul></nav>
    </div>
    <div class="legal">
      <span>© {{ "" | year }} ADQA · {{ site.legalName }}<span class="legal-slogan"><span class="legal-sep" aria-hidden="true"> · </span><span lang="en">We make I.T. better</span></span></span>
      <nav aria-label="Legal"><a href="/aviso-legal/">Aviso legal</a><a href="/politica-de-privacidad/">Privacidad</a><a href="/politica-de-seguridad/">Política de seguridad</a></nav>
    </div>
  </div>
</footer>
