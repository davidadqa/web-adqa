{%- macro navLink(url, label, external=false) -%}
<a href="{{ url }}"{% if page.url == url %} aria-current="page"{% endif %}{% if external %} rel="noopener"{% endif %}>{{ label }}</a>
{%- endmacro -%}
<header class="nav-shell" id="top">
  <nav class="nav" aria-label="Principal">
    <a class="nav-logo" href="/" aria-label="ADQA, inicio"><img src="/assets/logo-adqa.svg" alt="ADQA" width="134" height="22"></a>
    <ul class="nav-links">
      <li><button type="button" aria-expanded="false" aria-controls="mega-servicios" data-mega>Servicios <svg class="chev" aria-hidden="true"><use href="#i-chev"/></svg></button></li>
      {%- for l in nav.main %}
      <li>{{ navLink(l.url, l.label) }}</li>
      {%- endfor %}
    </ul>
    <div class="nav-cta">
      <a class="link" href="{{ site.extranet }}">Área clientes</a>
      <a class="btn btn-primary" href="/contacto/"{% if page.url == '/contacto/' %} aria-current="page"{% endif %}>Hablemos <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
      <button class="burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu"><span></span></button>
    </div>
  </nav>

  <div class="mega" id="mega-servicios" role="region" aria-label="Servicios">
    <div class="mega-grid">
      {%- for g in nav.groups %}
      {%- if g.wide %}
      <div class="mega-col mega-wide"><h4><span class="ico"><svg aria-hidden="true"><use href="#{{ g.icon }}"/></svg></span>{{ g.title }}</h4><ul>{% for l in g.links %}<li>{{ navLink(l.url, l.label, l.external) }}</li>{% endfor %}</ul></div>
      {%- else %}
      <div class="mega-col"><h4><span class="ico"><svg aria-hidden="true"><use href="#{{ g.icon }}"/></svg></span>{{ g.title }}</h4><ul>{% for l in g.links %}<li>{{ navLink(l.url, l.label, l.external) }}</li>{% endfor %}</ul></div>
      {%- endif %}
      {%- endfor %}
    </div>
    <aside class="mega-feature">
      <div style="display:grid;gap:10px">
        <h5>Certificación ENS categoría ALTA</h5>
        <p>El nivel más exigente del Esquema Nacional de Seguridad: preparados para trabajar con la administración pública.</p>
        <a href="/ciberseguridad/certificado-ens/">Qué significa para ti <svg width="14" height="14" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
      {#- P2-05: plano nocturno de las capas de seguridad (decorativo) -#}
      <svg class="p-chrome-layers" viewBox="0 0 240 128" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false"><g fill="none" stroke="#3a3a3a" stroke-width="1.5" stroke-dasharray="1"><rect class="t" x="4" y="4" width="232" height="120" rx="22" pathLength="1"/><rect class="t" style="--i:1" x="28" y="20" width="184" height="88" rx="14" pathLength="1"/><rect class="t" style="--i:2" x="52" y="36" width="136" height="56" rx="6" pathLength="1"/><rect class="t" style="--i:3" x="76" y="52" width="88" height="24" rx="4" pathLength="1"/></g><circle class="h" cx="120" cy="64" r="7.5" fill="#E32772" fill-opacity=".2"/><circle class="n" cx="120" cy="64" r="3.5" fill="#E32772"/><circle class="p" cx="120" cy="64" r="3.5" fill="none" stroke="#E32772" opacity="0"/></svg>
      <div class="tel">¿Prefieres llamar?<strong><a href="tel:{{ site.phoneE164 }}">{{ site.phone }}</a></strong></div>
    </aside>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <details><summary>Servicios <svg width="14" height="14" aria-hidden="true"><use href="#i-chev"/></svg></summary>
      {#- P2-03: cada servicio lleva su tecla de icono (decorativa; las etiquetas son las de nav.services) -#}
      {%- set svcIco = {"/ciberseguridad/": "i-shield", "/redes/": "i-net", "/telecomunicaciones/": "i-signal", "/sistemas-cloud/": "i-cloud", "/soporte-it/": "i-tool", "/diseno-programacion-web/": "i-code", "/google-workspace/": "i-grid", "/microsoft-365/": "i-grid"} %}
      <div class="sub">
        {%- for s in nav.services %}
        <a href="{{ s.url }}"{% if page.url == s.url %} aria-current="page"{% endif %}><span class="ico" aria-hidden="true"><svg><use href="#{{ svcIco[s.url] or 'i-grid' }}"/></svg></span>{{ s.label }}</a>
        {%- endfor %}
      </div>
    </details>
    {%- for l in nav.main %}
    {{ navLink(l.url, l.label) }}
    {%- endfor %}
    {{ navLink("/contacto/", "Contacto") }}
    <div class="m-cta">
      <a class="btn btn-primary" href="/contacto/">Hablemos <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
      <a class="btn btn-ghost" href="{{ site.extranet }}">Área clientes</a>
    </div>
  </div>
</header>
