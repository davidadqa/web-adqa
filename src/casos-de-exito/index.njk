    <div class="proj-grid cx-grid">
      {%- for c in casos %}
      {{ m.caseCard(c, idp="", sizes="(min-width: 1212px) 384px, (min-width: 721px) calc(50vw - 23px), calc(100vw - 32px)", cls="rv", style="--s:" + (loop.index0 % 3)) }}
