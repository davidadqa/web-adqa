    </div>
{%- set svcKeys = [["wifi","WiFi","con WiFi"],["fibra","Fibra e interconexión","con fibra e interconexión"],["networking","Networking","con networking"],["cloud","Cloud y CPD","con cloud y CPD"],["seguridad","Ciberseguridad","con ciberseguridad"],["web","Web y software","con web y software"],["workspace","Google Workspace","con Google Workspace"],["mant","Mantenimiento","con mantenimiento"]] %}
{%- set secKeys = [["sanidad","Sanidad","de sanidad"],["industria","Industria y minería","de industria y minería"],["administracion","Administración e instituciones","de administración e instituciones"],["horeca","Hostelería y HORECA","de hostelería y HORECA"],["empresas","Empresas y entidades","de empresas y entidades"]] %}

    <div class="cx-filter" data-filter hidden>
