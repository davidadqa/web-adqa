{% block scripts %}
<script>
/* Filtro de proyectos por servicio (mejora progresiva: sin JS se ven todos) */
(()=>{
  const bar=document.querySelector('[data-filter]');if(!bar)return;
  const cases=[...document.querySelectorAll('.case[data-svc]')],st=document.getElementById('filter-status');
  const btns=[...bar.querySelectorAll('button[data-f]')];
  const list=document.querySelector('.cases');
  const has=(c,f)=>f==='all'||c.dataset.svc.split(' ').includes(f);
  /* Recuentos calculados a partir de las fichas, para que nunca se desajusten */
  btns.forEach(b=>{const s=b.querySelector('small');if(s)s.textContent=cases.filter(c=>has(c,b.dataset.f)).length});
  const alt=()=>{let i=0;cases.forEach(c=>{if(!c.hidden)c.classList.toggle('alt',i++%2===1)})};
  bar.hidden=false;if(list)list.classList.add('js');alt();
  btns.forEach(b=>b.addEventListener('click',()=>{
    const f=b.dataset.f;let n=0;
    btns.forEach(x=>x.setAttribute('aria-pressed',x===b?'true':'false'));
    cases.forEach(c=>{const on=has(c,f);c.hidden=!on;if(on){n++;c.classList.add('in')}});
    alt();
    st.textContent=f==='all'?'Mostrando los '+n+' proyectos':'Mostrando '+n+' proyectos con '+b.dataset.l;
  }));
})();
</script>
{% endblock %}
