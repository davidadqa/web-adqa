{% block scripts %}
<script>
/* Filtro de casos por servicio o por sector, una sola tecla pulsada (mejora progresiva: sin JS se ven todos) */
(()=>{
  const bar=document.querySelector('[data-filter]');if(!bar)return;
  const cases=[...document.querySelectorAll('.cx-grid>.proj')],more=[...document.querySelectorAll('[data-more]')],st=document.getElementById('filter-status');
  const btns=[...bar.querySelectorAll('button[data-f]')],cota=document.querySelector('.cx-cota span');
  const has=(c,f)=>{if(f==='all')return true;const[k,v]=f.split(':');return k==='svc'?c.dataset.svc.split(' ').includes(v):c.dataset.sec===v};
  /* Recuentos calculados a partir de las tarjetas, para que nunca se desajusten */
  btns.forEach(b=>{const s=b.querySelector('small');if(s)s.textContent=cases.filter(c=>has(c,b.dataset.f)).length});
  bar.hidden=false;
  const rm=matchMedia('(prefers-reduced-motion: reduce)').matches,line=cota.parentNode;
  if(!rm)line.classList.add('p-armed','p-in');
  /* La cota vuelve a abrirse desde el centro: la tecla tiene consecuencia */
  const redraw=()=>{if(rm)return;line.classList.remove('p-in');void line.offsetWidth;line.classList.add('p-in')};
  const apply=b=>{
    const f=b.dataset.f;let n=0;
    btns.forEach(x=>x.setAttribute('aria-pressed',x===b?'true':'false'));
    cases.forEach(c=>{const on=has(c,f);c.hidden=!on;if(on){n++;c.classList.add('in')}});
    more.forEach(x=>{x.hidden=f!=='all';x.classList.add('in')});
    const t=n+(n===1?' caso':' casos')+(f==='all'?'':' '+b.dataset.l);
    cota.textContent=t;
    st.textContent=f==='all'?'Mostrando los '+n+' casos':'Mostrando '+t;
    redraw();
  };
  /* El filtro que desliza (View Transitions): todos aparecidos y sin transición a medias (nada de desenfoque), un nombre por
     caso solo mientras dura (si no, cada navegación entre páginas capturaría 16 grupos). Sin soporte o con reduced-motion, como siempre. */
  const vt=document.startViewTransition&&!rm;let last;
  btns.forEach(b=>b.addEventListener('click',()=>{
    if(!vt)return apply(b);
    cases.forEach(c=>{c.classList.add('in');c.querySelector('.hl')?.classList.replace('p-armed','p-in');c.getAnimations({subtree:true}).forEach(a=>a.finish());c.style.viewTransitionName='p-proof-case-'+c.id});
    const t=last=document.startViewTransition(()=>apply(b));
    t.finished.finally(()=>{if(last===t){last=0;cases.forEach(c=>c.style.viewTransitionName='')}});
  }));
  /* Mientras desliza, la página no recibe clics (llegan a <html>): se corta la transición y el clic va a la cápsula de debajo. */
  document.addEventListener('click',e=>{if(!last||e.target!==document.documentElement)return;last.skipTransition();const k=document.elementFromPoint(e.clientX,e.clientY);if(k&&k.closest('[data-f]'))k.closest('[data-f]').click()});
})();
</script>
{% endblock %}
