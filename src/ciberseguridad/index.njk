.ens .seal .imgs img{height:96px;width:auto;border-radius:10px;background:#fff}
.ens .seal b{display:block;font-size:2.6rem;font-weight:600;letter-spacing:-.04em;line-height:1;color:var(--ink)}
.ens .seal b span{color:var(--pink)}
@media (max-width:1060px){.ens{grid-template-columns:1fr}}
@media (max-width:720px){
  .gains{grid-template-columns:1fr}
  .gains .card{grid-template-columns:1fr;gap:14px;padding:26px}
  .ens .txt,.ens .seal{padding:26px}
  .note.card{padding:24px}
}
</style>
