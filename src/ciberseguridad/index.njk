.compare .cmp{display:flex;flex-direction:column}
.compare .cmp ul{margin-bottom:22px}
.cmp .q{margin-top:auto;padding-top:18px;border-top:1px solid var(--line);font-size:.95rem;color:var(--ink);font-weight:600}
