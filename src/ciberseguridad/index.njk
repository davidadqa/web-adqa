.ens{display:grid;grid-template-columns:1.15fr .85fr;gap:14px;align-items:stretch}
.ens .txt{display:grid;gap:18px;align-content:start;padding:38px}
.ens .txt ul{list-style:none;display:grid;gap:12px}
.ens .txt li{display:flex;gap:12px;align-items:flex-start;color:var(--ink)}
.ens .txt li svg{flex:none;width:20px;height:20px;margin-top:2px;color:var(--pink)}
.ens .seal{display:grid;gap:22px;align-content:center;justify-items:center;text-align:center;padding:38px;background:linear-gradient(160deg,#fff 30%,var(--pink-50));border-color:#f2c4d6}
